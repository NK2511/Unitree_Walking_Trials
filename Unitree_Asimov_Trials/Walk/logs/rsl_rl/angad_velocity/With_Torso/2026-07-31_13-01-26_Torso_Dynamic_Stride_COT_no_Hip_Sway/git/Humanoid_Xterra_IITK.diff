-"""
-chirp_system_id.py
-──────────────────────────────────────────────────────────────────────────────
-Furuta Pendulum — ARM MOTOR SYSTEM IDENTIFICATION via Chirp Signal
-
-What this does:
-  1. Applies a swept-sine (chirp) torque signal to the arm motor.
-  2. Records position + velocity from Moteus encoder.
-  3. Fits the equation of motion:
-
-       I·α + b·ω + τ_c·sign(ω) = τ_applied
-
-     using Ordinary Least Squares (numpy lstsq) to find:
-       • I    — effective rotational inertia at output shaft [kg·m²]
-       • b    — viscous damping coefficient [Nm·s/rad]
-       • τ_c  — Coulomb (dry) friction [Nm]
-
-  4. Plots raw data, regression fit quality, and a Bode magnitude estimate.
-
-Run:
-  python furuta_pendulum_balancing_task/chirp_system_id.py
-
-Safety:
-  • Keep pendulum FOLDED DOWN and SECURED (zip-tie or tape).
-  • Max torque is intentionally limited to CHIRP_AMP (0.15 Nm) — gentle.
-  • Arm must have full 360° clearance.
-──────────────────────────────────────────────────────────────────────────────
-"""
-
-import asyncio
-import math
-import time
-import numpy as np
-import matplotlib.pyplot as plt
-from scipy.signal import butter, filtfilt
-import moteus
-
-# =====================================================================
-# CONFIGURATION
-# =====================================================================
-
-GEAR_RATIO   = 8.0    # motor shaft to output shaft
-
-# Chirp parameters
-CHIRP_AMP    = 0.15   # Nm — max torque amplitude (keep LOW and safe)
-CHIRP_F_START = 0.2   # Hz — starting frequency
-CHIRP_F_END   = 4.0   # Hz — ending frequency
-CHIRP_DURATION = 20.0 # seconds — total sweep time
-
-# Low-frequency settling burst before chirp (to overcome stiction at start)
-SETTLE_TORQUE  = 0.05  # Nm
-SETTLE_TIME    = 1.0   # seconds
-
-# Velocity smoothing before differentiation
-VEL_LOWPASS_HZ = 30.0  # Hz — cutoff for velocity filter before differentiating
-
-# =====================================================================
-# HELPERS
-# =====================================================================
-
-def chirp_torque(t, amp, f_start, f_end, duration):
-    """Linear chirp: frequency sweeps from f_start to f_end over duration."""
-    k = (f_end - f_start) / duration          # Hz/s
-    phase = 2 * math.pi * (f_start * t + 0.5 * k * t ** 2)
-    return amp * math.sin(phase)
-
-
-def butter_lowpass(data, cutoff_hz, sample_hz, order=4):
-    """Zero-phase Butterworth lowpass filter."""
-    nyq = 0.5 * sample_hz
-    normal_cutoff = cutoff_hz / nyq
-    b, a = butter(order, normal_cutoff, btype='low', analog=False)
-    return filtfilt(b, a, data)
-
-
-def estimate_sample_rate(t_arr):
-    dt = np.diff(t_arr)
-    return 1.0 / np.median(dt)
-
-
-# =====================================================================
-# MAIN
-# =====================================================================
-
-async def main():
-    print("=" * 62)
-    print("  FURUTA ARM — CHIRP SYSTEM IDENTIFICATION")
-    print("=" * 62)
-    print("\nSAFETY CHECKLIST — confirm before proceeding:")
-    print("  [1] Pendulum folded DOWN and zip-tied or taped to the arm.")
-    print("  [2] Arm has full 360° clear space around it.")
-    print(f"  [3] Max torque = {CHIRP_AMP} Nm  (gentle).")
-    print("=" * 62)
-    input("\nPress ENTER when ready...")
-
-    controller = moteus.Controller(id=1)
-    await controller.set_stop()
-    await asyncio.sleep(0.2)
-
-    log = {
-        "t":       [],
-        "tau_cmd": [],  # commanded torque [Nm]
-        "pos":     [],  # output-shaft position [rev]
-        "vel":     [],  # output-shaft velocity  [rev/s]
-    }
-
-    # ── PHASE 1: Settle (tiny constant torque so arm is actually moving) ──
-    print(f"\nPhase 1: Settling for {SETTLE_TIME}s at {SETTLE_TORQUE} Nm ...")
-    settle_start = time.perf_counter()
-    while time.perf_counter() - settle_start < SETTLE_TIME:
-        await controller.set_position(
-            position=math.nan,
-            velocity=math.nan,
-            kp_scale=0.0,
-            kd_scale=0.0,
-            feedforward_torque=SETTLE_TORQUE,
-            maximum_torque=CHIRP_AMP + 0.05,
-        )
-        await asyncio.sleep(0.002)
-
-    # ── PHASE 2: Chirp ────────────────────────────────────────────────────
-    print(f"Phase 2: Chirp  {CHIRP_F_START}–{CHIRP_F_END} Hz  over {CHIRP_DURATION}s ...")
-    chirp_start = time.perf_counter()
-
-    while True:
-        t = time.perf_counter() - chirp_start
-        if t > CHIRP_DURATION:
-            break
-
-        tau = chirp_torque(t, CHIRP_AMP, CHIRP_F_START, CHIRP_F_END, CHIRP_DURATION)
-
-        state = await controller.set_position(
-            position=math.nan,
-            velocity=math.nan,
-            kp_scale=0.0,
-            kd_scale=0.0,
-            feedforward_torque=tau,
-            maximum_torque=CHIRP_AMP + 0.05,
-            query=True,
-        )
-
-        if state is not None:
-            pos_motor = state.values.get(moteus.Register.POSITION, math.nan)
-            vel_motor = state.values.get(moteus.Register.VELOCITY, math.nan)
-
-            # Convert from motor-shaft to output-shaft
-            pos_out = pos_motor / GEAR_RATIO   # revolutions
-            vel_out = vel_motor / GEAR_RATIO   # rev/s
-
-            log["t"].append(t)
-            log["tau_cmd"].append(tau)
-            log["pos"].append(pos_out)
-            log["vel"].append(vel_out)
-
-        await asyncio.sleep(0.002)
-
-    await controller.set_stop()
-    print("\nDone! Processing data ...")
-    analyze_and_plot(log)
-
-
-# =====================================================================
-# ANALYSIS
-# =====================================================================
-
-def analyze_and_plot(log):
-    t       = np.array(log["t"])
-    tau_cmd = np.array(log["tau_cmd"])
-    vel_rev = np.array(log["vel"])
-
-    if len(t) < 50:
-        print("Not enough data collected.")
-        return
-
-    # Convert velocity rev/s → rad/s
-    omega = vel_rev * 2 * math.pi
-
-    fs = estimate_sample_rate(t)
-    print(f"  Estimated sample rate: {fs:.1f} Hz")
-
-    # ── Smooth velocity before differentiating ────────────────────────
-    omega_filt = butter_lowpass(omega, VEL_LOWPASS_HZ, fs)
-
-    # ── Compute angular acceleration ──────────────────────────────────
-    alpha = np.gradient(omega_filt, t)  # rad/s²
-
-    # ── Least-squares regression ──────────────────────────────────────
-    # Equation: I·α + b·ω + τ_c·sign(ω) = τ
-    # Rearrange as: τ = [α, ω, sign(ω)] · [I, b, τ_c]ᵀ
-    # We trim the first and last 5% to avoid filter edge artefacts.
-    trim = int(0.05 * len(t))
-    t_fit       = t[trim:-trim]
-    tau_fit     = tau_cmd[trim:-trim]
-    alpha_fit   = alpha[trim:-trim]
-    omega_fit   = omega_filt[trim:-trim]
-
-    A = np.column_stack([
-        alpha_fit,
-        omega_fit,
-        np.sign(omega_fit),
-    ])
-    b_vec = tau_fit
-
-    params, residuals, rank, sv = np.linalg.lstsq(A, b_vec, rcond=None)
-    I_est, b_est, tau_c_est = params
-
-    tau_predicted = A @ params
-    ss_res = np.sum((b_vec - tau_predicted) ** 2)
-    ss_tot = np.sum((b_vec - np.mean(b_vec)) ** 2)
-    r2 = 1 - ss_res / ss_tot if ss_tot > 0 else float('nan')
-
-    print("\n" + "=" * 50)
-    print("  IDENTIFIED MOTOR PARAMETERS")
-    print("=" * 50)
-    print(f"  Inertia  I  = {I_est:.6f}  kg·m²")
-    print(f"  Damping  b  = {b_est:.6f}  Nm·s/rad")
-    print(f"  Coulomb τ_c = {tau_c_est:.6f}  Nm")
-    print(f"  Fit R²      = {r2:.4f}  (1.0 = perfect)")
-    print("=" * 50)
-    print("\nMuJoCo XML values to use:")
-    print(f"  <joint ... damping=\"{b_est:.5f}\" frictionloss=\"{tau_c_est:.5f}\" armature=\"{I_est:.6f}\" />")
-    print("=" * 50)
-
-    # ── PLOTS ─────────────────────────────────────────────────────────
-    fig, axes = plt.subplots(4, 1, figsize=(13, 12), sharex=False)
-    fig.suptitle("Furuta Arm — Chirp System Identification Results", fontsize=14)
-
-    # 1. Input torque
-    axes[0].plot(t, tau_cmd, 'b', linewidth=0.8)
-    axes[0].set_ylabel("τ commanded (Nm)")
-    axes[0].set_title("Input: Chirp Torque Signal")
-    axes[0].grid(True)
-
-    # 2. Measured velocity
-    axes[1].plot(t, omega,      'lightblue', linewidth=0.6, label="Raw ω")
-    axes[1].plot(t, omega_filt, 'b',         linewidth=1.2, label="Filtered ω")
-    axes[1].set_ylabel("ω (rad/s)")
-    axes[1].set_title("Output: Angular Velocity (Motor Output Shaft)")
-    axes[1].legend(fontsize=8)
-    axes[1].grid(True)
-
-    # 3. Regression fit quality (fitted vs actual torque)
-    axes[2].plot(t_fit, b_vec,          'b',  linewidth=0.8, label="Actual τ",    alpha=0.7)
-    axes[2].plot(t_fit, tau_predicted,  'r--',linewidth=1.0, label="Predicted τ", alpha=0.9)
-    axes[2].set_ylabel("Torque (Nm)")
-    axes[2].set_title(f"Regression Fit Quality  (R² = {r2:.4f})")
-    axes[2].legend(fontsize=8)
-    axes[2].grid(True)
-    axes[2].set_xlabel("Time (s)")
-
-    # 4. Bode magnitude estimate (torque → velocity ratio vs frequency)
-    from numpy.fft import rfft, rfftfreq
-    if len(t_fit) > 64:
-        freq  = rfftfreq(len(t_fit), d=1.0/fs)
-        TAU_F = np.abs(rfft(b_vec))
-        OMG_F = np.abs(rfft(omega_fit))
-        # Avoid divide-by-zero
-        mask  = TAU_F > 1e-6
-        gain  = np.zeros_like(freq)
-        gain[mask] = OMG_F[mask] / TAU_F[mask]
-        axes[3].semilogy(freq[1:], gain[1:], 'g', linewidth=1.0)
-        axes[3].set_xlabel("Frequency (Hz)")
-        axes[3].set_ylabel("|ω/τ|  (rad/s / Nm)")
-        axes[3].set_title("Bode Magnitude  (torque → velocity)")
-        axes[3].set_xlim([0, CHIRP_F_END + 1])
-        axes[3].grid(True, which='both')
-    else:
-        axes[3].text(0.5, 0.5, "Not enough data for Bode plot",
-                     ha='center', va='center', transform=axes[3].transAxes)
-
-    plt.tight_layout()
-
-    # Save CSV for later
-    try:
-        import csv
-        fname = "chirp_system_id_log.csv"
-        with open(fname, "w", newline="") as f:
-            w = csv.writer(f)
-            w.writerow(["t", "tau_cmd", "vel_rad_s"])
-            for i in range(len(t)):
-                w.writerow([t[i], tau_cmd[i], omega[i]])
-        print(f"\nRaw data saved to {fname}")
-    except Exception as e:
-        print(f"Could not save CSV: {e}")
-
-    plt.show()
-
-
-# =====================================================================
-# ENTRY
-# =====================================================================
-
-if __name__ == "__main__":
-    asyncio.run(main())
